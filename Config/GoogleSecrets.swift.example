//
//  GoogleSecrets.swift
//  Local only. Keep this file out of git (it's listed in .gitignore).
//
//  To use: copy this file to Shared/GoogleSecrets.swift and paste your Desktop-app OAuth client secret.
//  Google says a desktop app's secret can't be kept confidential, since it ships inside the app,
//  but keeping it out of the repository avoids secret-scanner alerts.
//

import Foundation

nonisolated enum GoogleSecrets {
    static let clientSecret = "YOUR_CLIENT_SECRET"
}
